# Everkind Care System — Environment Configuration
# Copy this file to .env and fill in your actual values

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/everkind
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_SSL=true

# ── Admin Credentials ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@everkind.com
ADMIN_PASSWORD=change_me

# ── SMTP Email (for payslip delivery) ─────────────────────────────────────────
# Supports Gmail, Office 365, SendGrid, Mailgun, etc.
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youremail@gmail.com
#   SMTP_PASS=your_app_password
# Office 365 example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=payroll@everkind.ie

# ── Company Details (appear on payslips) ──────────────────────────────────────
COMPANY_NAME=Everkind Home Care Ltd
COMPANY_REG=IE000000
COMPANY_ERN=0000000A
COMPANY_ADDRESS=Dublin, Ireland
COMPANY_PHONE=+353 1 000 0000
COMPANY_EMAIL=payroll@everkind.ie
COMPANY_WEBSITE=www.everkind.ie

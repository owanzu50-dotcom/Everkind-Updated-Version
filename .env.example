# Everkind Care System — Environment Configuration
# Copy this file to .env and fill in your actual values

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
TRUST_PROXY=0
SESSION_SECRET=change_me
MFA_ENCRYPTION_KEY=change_me

# ── Production Database (required; no SQLite runtime fallback) ─────────────────
DB_PROVIDER=postgres
DATABASE_MODE=postgres
DATABASE_URL=
# Optional custom CA path. The official Supabase CA bundled with the app is used
# when this is empty.
PGSSLROOTCERT=

# ── Admin Credentials ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@everkind.com
ADMIN_PASSWORD=change_me
STAFF_EMAIL=staff@everkind.com
STAFF_PASSWORD=change_me

# ── SMTP Email (for payslip delivery) ─────────────────────────────────────────
# Supports Gmail, Office 365, SendGrid, Mailgun, etc.
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youremail@gmail.com
#   SMTP_PASS=your_app_password
# Office 365 example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=payroll@everkind.ie

# ── Company Details (appear on payslips) ──────────────────────────────────────
COMPANY_NAME=Everkind Home Care Ltd
COMPANY_REG=IE000000
COMPANY_ERN=0000000A
COMPANY_ADDRESS=Dublin, Ireland
COMPANY_PHONE=+353 1 000 0000
COMPANY_EMAIL=payroll@everkind.ie
COMPANY_WEBSITE=www.everkind.ie

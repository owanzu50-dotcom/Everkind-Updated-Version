<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/logo.png">
</head>
<body class="portal-page">
    <div class="portal-shell">
        <div class="portal-card">
            <div class="portal-branding">
                <img class="brand-logo" src="/images/logo.png" alt="Everkind logo" />
                <div>
                    <h1>Everkind</h1>
                    <p>Staff password reset</p>
                </div>
            </div>

            <h2>Forgot your password?</h2>
            <p class="portal-subtext">Enter your staff email to generate a secure reset code.</p>
            <% if (error) { %><div class="form-message error"><%= error %></div><% } %>
            <% if (message) { %><div class="form-message success"><%= message %></div><% } %>
            <% if (previewCode) { %>
                <div class="form-message success">
                    Development preview code: <strong><%= previewCode %></strong>
                </div>
            <% } %>

            <form class="portal-form" method="POST" action="/portal/forgot-password">
                <label>
                    Staff email
                    <input type="email" name="email" placeholder="you@everkind.com" required>
                </label>
                <button type="submit" class="primary-button full-width">Generate reset code</button>
            </form>

            <div class="portal-links">
                <a href="/portal/reset-password">I already have a code</a>
                <a href="/portal/login">Back to sign in</a>
            </div>
        </div>
    </div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css"><link rel="icon" type="image/png" href="/images/logo.png">
</head>
<body>
    <header>
        <h1>Everkind Care System</h1>
        <nav>
            <a href="/">Home</a>
            <a href="/patients">Patients</a>
            <a href="/staff">Staff</a>
            <a href="/calendar">Calendar</a>
            <a href="/admin">Admin</a>
            <a href="/api/health">Health Check</a>
        </nav>
    </header>

    <% const returnTarget = (typeof returnPath !== 'undefined' && returnPath) ? returnPath : ((typeof isAdmin !== 'undefined' && isAdmin) ? '/admin/dashboard' : '/'); %>
    <main class="page-shell">
        <section class="detail-card error-card">
            <h2><%= title %></h2>
            <p><%= message %></p>
            <a href="<%= returnTarget %>" class="secondary-link">Return home</a>
        </section>
    </main>

    <footer>
        © 2026 Everkind Care System
    </footer>
</body>
</html>

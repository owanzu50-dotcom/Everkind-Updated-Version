<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/logo.png">
</head>
<body class="portal-shell-page">
    <div class="portal-layout">
        <%- include('partials/portal-sidebar', { active: 'facilities', isAdmin: true, currentStaffName, currentStaffEmail }) %>
        <main class="portal-content">
            <div class="adm-page-header">
                <div>
                    <h1 class="adm-page-title">Healthcare Facilities</h1>
                    <p class="adm-page-subtitle">Registered healthcare organisations only.</p>
                </div>
            </div>
            <div class="adm-metric-grid" style="margin-bottom:16px;">
                <div class="adm-metric-card"><div class="adm-metric-icon blue">🏥</div><span class="adm-metric-label">Total Facilities</span><span class="adm-metric-value"><%= summary.total %></span></div>
                <div class="adm-metric-card"><div class="adm-metric-icon amber">⏳</div><span class="adm-metric-label">Pending</span><span class="adm-metric-value"><%= summary.pending %></span></div>
                <div class="adm-metric-card"><div class="adm-metric-icon green">✅</div><span class="adm-metric-label">Approved</span><span class="adm-metric-value"><%= summary.approved %></span></div>
                <div class="adm-metric-card"><div class="adm-metric-icon purple">⛔</div><span class="adm-metric-label">Suspended</span><span class="adm-metric-value"><%= summary.suspended %></span></div>
            </div>
            <div class="adm-card">
                <% if (facilities.length) { %>
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <thead>
                                <tr>
                                    <th>Facility</th>
                                    <th>Type</th>
                                    <th>Address</th>
                                    <th>Contact</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% facilities.forEach((facility) => { %>
                                    <tr>
                                        <td><strong><%= facility.accountId %></strong><br><%= facility.organization_name %></td>
                                        <td><%= facility.organization_type || 'Not set' %></td>
                                        <td><%= [facility.address_line_1, facility.town, facility.county, facility.eircode].filter(Boolean).join(', ') %></td>
                                        <td><%= facility.contact_first_name %> <%= facility.contact_last_name %><br><span style="font-size:0.8rem;color:#64748b;"><%= facility.email %></span></td>
                                        <td><span class="adm-badge adm-badge-<%= facility.statusClass %>"><%= String(facility.status || '').replace(/_/g, ' ') %></span></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="adm-card-empty"><p>No healthcare facilities registered yet.</p></div>
                <% } %>
            </div>
        </main>
    </div>
</body>
</html>

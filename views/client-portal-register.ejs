<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/logo.png">
    <%- include('partials/portal-theme-head') %>
    <style>
        .registration-hero {
            background: linear-gradient(135deg, #0f4c81 0%, #1d5f9e 100%);
            color: white;
            border-radius: 16px;
            padding: 20px 22px;
            margin-bottom: 20px;
        }
        .registration-hero h2 {
            margin: 0 0 6px;
            color: white;
            font-size: 24px;
        }
        .registration-hero p {
            margin: 0;
            color: rgba(255,255,255,0.92);
            font-size: 14px;
            line-height: 1.5;
        }
        .registration-steps {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
            margin: 16px 0 18px;
        }
        .registration-step {
            background: #f8fbff;
            border: 1px solid #dfe9f5;
            border-radius: 12px;
            padding: 10px;
            text-align: center;
            font-size: 12px;
            color: #265c8b;
            font-weight: 600;
        }
        .registration-step strong {
            display: block;
            margin-bottom: 3px;
            color: #124368;
        }
        .portal-card .staff-form-section {
            border-radius: 14px;
            padding: 16px;
            margin-bottom: 12px;
        }
        .portal-card .staff-form-section-header h3 {
            margin: 0;
            color: #0f4c81;
        }
        .portal-card .checkbox-field {
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 10px 12px;
            background: #fafcff;
        }
        @media (max-width: 700px) {
            .registration-steps {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body class="portal-page">
    <div class="portal-shell" style="width:min(700px, calc(100% - 32px));">
        <div class="portal-card">
            <div class="portal-branding">
                <img class="brand-logo" src="/images/logo.png" alt="Everkind logo" />
                <div>
                    <h1>Everkind</h1>
                    <p>Staffing services registration</p>
                </div>
            </div>

            <div class="registration-hero">
                <h2>Create your account</h2>
                <p>Fast, secure onboarding for healthcare organisations. In just a few minutes you can get started, then complete your profile once approved.</p>
            </div>

            <div class="registration-steps">
                <div class="registration-step"><strong>1</strong>Create your account</div>
                <div class="registration-step"><strong>2</strong>Admin review</div>
                <div class="registration-step"><strong>3</strong>Complete your profile</div>
            </div>

            <% if (error) { %><div class="form-message error"><%= error %></div><% } %>
            <% if (message) { %><div class="form-message success"><%= message %></div><% } %>

            <form class="portal-form" method="POST" action="/client-portal/register">
                <div class="staff-form-section">
                    <div class="staff-form-section-header">
                        <div>
                            <h3>Your organisation</h3>
                        </div>
                    </div>
                    <div class="staff-form-grid">
                        <label><span>Organisation Name *</span>
                            <input type="text" name="organization_name" value="<%= formData ? formData.organizationName : '' %>" required placeholder="e.g. St. Mary's Nursing Home">
                        </label>
                        <label><span>Type of Organisation *</span>
                            <select name="organization_type" required>
                                <option value="">-- Select --</option>
                                <% clientPortalOrganizationTypes.forEach((option) => { %>
                                    <option value="<%= option %>" <%= formData && formData.organizationType === option ? 'selected' : '' %>><%= option %></option>
                                <% }) %>
                            </select>
                        </label>
                    </div>
                </div>

                <div class="staff-form-section">
                    <div class="staff-form-section-header">
                        <div>
                            <h3>Main contact</h3>
                        </div>
                    </div>
                    <div class="staff-form-grid">
                        <label><span>First Name *</span>
                            <input type="text" name="contact_first_name" value="<%= formData ? formData.contactFirstName : '' %>" required placeholder="Your first name">
                        </label>
                        <label><span>Last Name *</span>
                            <input type="text" name="contact_last_name" value="<%= formData ? formData.contactLastName : '' %>" required placeholder="Your last name">
                        </label>
                        <label><span>Job Title *</span>
                            <input type="text" name="contact_job_title" value="<%= formData ? formData.contactJobTitle : '' %>" required placeholder="e.g. Manager">
                        </label>
                        <label><span>Work Email *</span>
                            <input type="email" name="email" value="<%= formData ? formData.email : '' %>" required placeholder="your.email@organisation.ie">
                        </label>
                        <label><span>Mobile Number *</span>
                            <input type="text" name="mobile_number" value="<%= formData ? formData.mobileNumber : '' %>" required placeholder="087 123 4567">
                        </label>
                    </div>
                </div>

                <div class="staff-form-section">
                    <div class="staff-form-section-header">
                        <div>
                            <h3>Create password</h3>
                        </div>
                    </div>
                    <div class="staff-form-grid">
                        <label><span>Password *</span>
                            <input type="password" name="password" required placeholder="At least 8 characters">
                        </label>
                        <label><span>Confirm Password *</span>
                            <input type="password" name="confirm_password" required placeholder="Confirm your password">
                        </label>
                    </div>
                </div>

                <div class="staff-form-section">
                    <div class="multi-select-grid">
                        <label class="checkbox-field">
                            <input type="checkbox" name="terms_agreement" value="1" required>
                            <span>I agree to the <a href="/terms" target="_blank">Terms &amp; Conditions</a> *</span>
                        </label>
                        <label class="checkbox-field">
                            <input type="checkbox" name="privacy_agreement" value="1" required>
                            <span>I agree to the <a href="/privacy" target="_blank">Privacy Policy</a> *</span>
                        </label>
                    </div>
                </div>

                <div style="display:flex;gap:12px;flex-wrap:wrap;">
                    <button type="submit" class="primary-button">Create Account</button>
                    <a href="/client-portal/login" class="secondary-button">Already have an account? Login</a>
                </div>
            </form>
            <%- include('partials/portal-theme-toggle') %>
        </div>
    </div>
</body>
</html>

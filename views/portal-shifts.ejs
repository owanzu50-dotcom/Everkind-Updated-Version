<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/logo.png">
</head>
<body class="portal-shell-page">
    <div class="portal-layout">
        <%- include('partials/portal-sidebar', { active: 'shifts', isAdmin: Boolean(isAdmin), currentStaffName: currentStaffName, currentStaffEmail: typeof currentStaffEmail !== 'undefined' ? currentStaffEmail : '' }) %>

        <main class="portal-content">

        <% if (isAdmin) { %>
            <!-- ========== ADMIN: Schedule management view ========== -->
            <% const filters = scheduleFilters || {}; %>
            <% const summary = scheduleSummary || { all: shifts.length, homeCare: 0, agency: 0, open: 0, scheduled: 0, inProgress: 0, completed: 0, missed: 0, attendanceExceptions: 0, cancelled: 0 }; %>
            <header class="portal-header">
                <div>
                    <span class="eyebrow">Central operations</span>
                    <h1>Schedule</h1>
                    <p style="margin-top:4px;color:var(--text-muted);font-weight:600">
                        <%= summary.all %> shift<%= summary.all !== 1 ? 's' : '' %> total
                    </p>
                </div>
                <div class="header-actions">
                    <a href="/calendar" class="primary-button">+ Add shift</a>
                    <strong class="portal-user-name"><%= currentStaffName %></strong>
                </div>
            </header>

            <div class="adm-metric-grid" style="margin-bottom:16px;">
                <a class="adm-metric-link" href="/admin/schedule"><div class="adm-metric-card <%= (filters.division || 'all') === 'all' && (filters.status || 'all') === 'all' ? 'active' : '' %>"><div class="adm-metric-icon blue">📅</div><span class="adm-metric-label">All Shifts</span><span class="adm-metric-value"><%= summary.all %></span></div></a>
                <a class="adm-metric-link" href="/admin/schedule?division=home-care"><div class="adm-metric-card <%= filters.division === 'home-care' ? 'active' : '' %>"><div class="adm-metric-icon green">🏠</div><span class="adm-metric-label">Home Care</span><span class="adm-metric-value"><%= summary.homeCare %></span></div></a>
                <a class="adm-metric-link" href="/admin/schedule?division=agency-staffing"><div class="adm-metric-card <%= filters.division === 'agency-staffing' ? 'active' : '' %>"><div class="adm-metric-icon blue">🏥</div><span class="adm-metric-label">Agency Shifts</span><span class="adm-metric-value"><%= summary.agency %></span></div></a>
                <a class="adm-metric-link" href="/admin/schedule?status=open"><div class="adm-metric-card <%= filters.status === 'open' ? 'active' : '' %>"><div class="adm-metric-icon amber">🟠</div><span class="adm-metric-label">Open</span><span class="adm-metric-value"><%= summary.open %></span></div></a>
                <a class="adm-metric-link" href="/admin/schedule?status=scheduled"><div class="adm-metric-card <%= filters.status === 'scheduled' ? 'active' : '' %>"><div class="adm-metric-icon green">🟢</div><span class="adm-metric-label">Scheduled</span><span class="adm-metric-value"><%= summary.scheduled %></span></div></a>
                <a class="adm-metric-link" href="/admin/schedule?status=in_progress"><div class="adm-metric-card <%= filters.status === 'in_progress' ? 'active' : '' %>"><div class="adm-metric-icon blue">🔵</div><span class="adm-metric-label">In Progress</span><span class="adm-metric-value"><%= summary.inProgress %></span></div></a>
                <a class="adm-metric-link" href="/admin/schedule?status=completed"><div class="adm-metric-card <%= filters.status === 'completed' ? 'active' : '' %>"><div class="adm-metric-icon purple">✅</div><span class="adm-metric-label">Completed</span><span class="adm-metric-value"><%= summary.completed %></span></div></a>
            </div>

            <section class="portal-panel" style="margin-bottom:16px;">
                <form method="GET" action="/admin/schedule" class="adm-form-grid-2" style="display:grid;gap:10px;">
                    <input class="adm-form-input" type="text" name="q" value="<%= filters.q || '' %>" placeholder="Search staff, home care client, facility, role, county, status, IDs...">
                    <div style="display:flex;gap:8px;flex-wrap:wrap;">
                        <button class="adm-btn-secondary" type="submit">Search</button>
                        <a href="/admin/schedule" class="adm-btn-secondary">Reset</a>
                    </div>
                    <select class="adm-form-select" name="division">
                        <option value="all" <%= (filters.division || 'all') === 'all' ? 'selected' : '' %>>All divisions</option>
                        <option value="home-care" <%= filters.division === 'home-care' ? 'selected' : '' %>>🏠 Home Care</option>
                        <option value="agency-staffing" <%= filters.division === 'agency-staffing' ? 'selected' : '' %>>🏥 Agency</option>
                    </select>
                    <select class="adm-form-select" name="status">
                        <option value="all" <%= (filters.status || 'all') === 'all' ? 'selected' : '' %>>All statuses</option>
                        <option value="open" <%= filters.status === 'open' ? 'selected' : '' %>>Open</option>
                        <option value="scheduled" <%= filters.status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
                        <option value="not_clocked_in" <%= filters.status === 'not_clocked_in' ? 'selected' : '' %>>Not Clocked In</option>
                        <option value="running_late" <%= filters.status === 'running_late' ? 'selected' : '' %>>Running Late</option>
                        <option value="on_duty" <%= filters.status === 'on_duty' ? 'selected' : '' %>>On Duty</option>
                        <option value="break" <%= filters.status === 'break' ? 'selected' : '' %>>Break</option>
                        <option value="in_progress" <%= filters.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                        <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
                        <option value="missed" <%= filters.status === 'missed' ? 'selected' : '' %>>Missed / No Show</option>
                        <option value="attendance_exception" <%= filters.status === 'attendance_exception' ? 'selected' : '' %>>Attendance Exception</option>
                        <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                    </select>
                    <input class="adm-form-input" type="date" name="date_from" value="<%= filters.dateFrom || '' %>">
                    <input class="adm-form-input" type="date" name="date_to" value="<%= filters.dateTo || '' %>">
                    <select class="adm-form-select" name="staff_id">
                        <option value="">All staff</option>
                        <% staff.forEach((member) => { %>
                            <option value="<%= member.id %>" <%= String(filters.staffId || '') === String(member.id) ? 'selected' : '' %>><%= member.name %></option>
                        <% }) %>
                    </select>
                    <select class="adm-form-select" name="patient_id">
                        <option value="">All Home Care Clients</option>
                        <% patients.forEach((client) => { %>
                            <option value="<%= client.id %>" <%= String(filters.patientId || '') === String(client.id) ? 'selected' : '' %>><%= client.clientId %> · <%= client.preferredName || client.name %></option>
                        <% }) %>
                    </select>
                    <select class="adm-form-select" name="facility_id">
                        <option value="">All Healthcare Facilities</option>
                        <% facilities.forEach((facility) => { %>
                            <option value="<%= facility.id %>" <%= String(filters.facilityId || '') === String(facility.id) ? 'selected' : '' %>><%= facility.accountId %> · <%= facility.displayName %></option>
                        <% }) %>
                    </select>
                    <select class="adm-form-select" name="facility_type">
                        <option value="">All facility types</option>
                        <% facilityTypes.forEach((type) => { %>
                            <option value="<%= type %>" <%= String(filters.facilityType || '') === String(type) ? 'selected' : '' %>><%= type %></option>
                        <% }) %>
                    </select>
                    <select class="adm-form-select" name="county">
                        <option value="">All counties</option>
                        <% counties.forEach((countyOption) => { %>
                            <option value="<%= countyOption %>" <%= String(filters.county || '') === String(countyOption) ? 'selected' : '' %>><%= countyOption %></option>
                        <% }) %>
                    </select>
                    <input class="adm-form-input" type="text" name="role" value="<%= filters.role || '' %>" placeholder="Staff role / shift requirement">
                </form>
                <div class="adm-filter-tabs" style="margin-top:10px;">
                    <a class="adm-filter-tab <%= (filters.division || 'all') === 'all' && (filters.status || 'all') === 'all' ? 'active' : '' %>" href="/admin/schedule">All</a>
                    <a class="adm-filter-tab <%= (filters.division || '') === 'home-care' ? 'active' : '' %>" href="/admin/schedule?division=home-care">🏠 Home Care</a>
                    <a class="adm-filter-tab <%= (filters.division || '') === 'agency-staffing' ? 'active' : '' %>" href="/admin/schedule?division=agency-staffing">🏥 Agency</a>
                    <a class="adm-filter-tab <%= (filters.status || '') === 'open' ? 'active' : '' %>" href="/admin/schedule?status=open">Open</a>
                    <a class="adm-filter-tab <%= (filters.status || '') === 'scheduled' ? 'active' : '' %>" href="/admin/schedule?status=scheduled">Scheduled</a>
                    <a class="adm-filter-tab <%= (filters.status || '') === 'in_progress' ? 'active' : '' %>" href="/admin/schedule?status=in_progress">In Progress</a>
                    <a class="adm-filter-tab <%= (filters.status || '') === 'completed' ? 'active' : '' %>" href="/admin/schedule?status=completed">Completed</a>
                    <a class="adm-filter-tab <%= (filters.status || '') === 'missed' ? 'active' : '' %>" href="/admin/schedule?status=missed">Missed</a>
                    <a class="adm-filter-tab <%= (filters.status || '') === 'attendance_exception' ? 'active' : '' %>" href="/admin/schedule?status=attendance_exception">Attendance Exceptions</a>
                    <a class="adm-filter-tab <%= (filters.status || '') === 'cancelled' ? 'active' : '' %>" href="/admin/schedule?status=cancelled">Cancelled</a>
                </div>
            </section>

            <section class="portal-panel" style="padding:0;overflow:hidden">
                <% if (shifts && shifts.length) { %>
                    <div class="compliance-table-wrap">
                        <table class="shift-table" id="shifts-table">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Staff</th>
                                    <th>Home Care Client / Facility</th>
                                    <th>Location</th>
                                    <th>Role</th>
                                    <th>Care / Shift Requirement</th>
                                    <th>Status</th>
                                    <th style="width:132px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% shifts.forEach((shift) => {
                                    const startDate = shift.scheduledStart ? new Date(shift.scheduledStart) : null;
                                    const endDate   = shift.scheduledEnd   ? new Date(shift.scheduledEnd)   : null;
                                    const dateStr   = startDate ? startDate.toLocaleDateString('en-IE',{day:'2-digit',month:'short',year:'numeric'}) : '—';
                                    const startStr  = startDate ? startDate.toLocaleTimeString('en-IE',{hour:'2-digit',minute:'2-digit',hour12:false}) : '';
                                    const endStr    = endDate   ? endDate.toLocaleTimeString('en-IE',{hour:'2-digit',minute:'2-digit',hour12:false})   : '';
                                %>
                                <tr class="shift-row" data-status="<%= shift.status %>">
                                    <td><span class="adm-badge <%= shift.serviceDivision === 'agency-staffing' ? 'adm-badge-agency' : 'adm-badge-home-care' %>"><%= shift.serviceDivisionLabel %></span><br><small><%= shift.shiftCode || ('#' + shift.id) %></small></td>
                                    <td><%= dateStr %></td>
                                    <td><%= startStr %><% if (endStr) { %> – <%= endStr %><% } %></td>
                                    <td><%= shift.staffName %></td>
                                    <td>
                                        <strong><%= shift.displayEntityName %></strong>
                                        <% if (shift.serviceDivision === 'home-care' && shift.home_care_client_id) { %><br><small><%= shift.home_care_client_id %></small><% } %>
                                        <% if (shift.serviceDivision === 'agency-staffing' && shift.facility_id) { %><br><small><%= shift.facility_id %></small><% } %>
                                    </td>
                                    <td><%= [shift.address, shift.county].filter(Boolean).join(', ') || 'Location pending' %></td>
                                    <td><%= shift.roleRequired || shift.serviceType %></td>
                                    <td><%= shift.requirementLabel || shift.serviceType %></td>
                                    <td>
                                        <span class="badge shift-status-<%= shift.statusClass %>">
                                            <%= shift.statusLabel %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="row-actions">
                                            <a class="icon-btn" title="View shift details" href="/admin/shifts/<%= shift.id %>">🔎</a>
                                            <button class="icon-btn"
                                                type="button"
                                                title="Edit shift"
                                                data-action="edit"
                                                data-id="<%= shift.id %>"
                                                data-staff-id="<%= shift.staffId %>"
                                                data-patient-id="<%= shift.patientId %>"
                                                data-start="<%= shift.scheduledStart || '' %>"
                                                data-end="<%= shift.scheduledEnd || '' %>"
                                                data-service="<%= shift.serviceType %>"
                                                data-status="<%= shift.storedStatus %>"
                                                data-notes="<%= (shift.careInstructions || shift.notes || '').replace(/"/g, '&quot;') %>">✏️</button>
                                            <button class="icon-btn icon-btn-danger"
                                                type="button"
                                                title="Delete shift"
                                                data-action="delete"
                                                data-id="<%= shift.id %>">🗑️</button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="empty-hint" style="padding:40px;text-align:center">
                        No shifts scheduled yet. <a href="/calendar" style="color:var(--brand-mint);font-weight:700">Schedule one →</a>
                    </div>
                <% } %>
                <p id="no-match-msg" class="empty-hint" style="display:none;padding:24px;text-align:center">No shifts match this filter.</p>
            </section>

            <!-- Edit shift modal overlay -->
            <div id="edit-modal" class="modal-backdrop" style="display:none" role="dialog" aria-modal="true" aria-labelledby="modal-title">
                <div class="modal-box">
                    <div class="modal-header">
                        <h2 id="modal-title">Edit shift</h2>
                        <button class="modal-close" id="modal-close" aria-label="Close">✕</button>
                    </div>
                    <form id="edit-form" class="portal-form">
                        <input type="hidden" id="edit-shift-id">
                        <label>
                            Staff member
                            <select id="edit-staff-id">
                                <option value="">Select staff…</option>
                                <% staff.forEach(s => { %>
                                    <option value="<%= s.id %>"><%= s.displayNameWithStatus || s.name || ((s.first_name||'') + ' ' + (s.last_name||'')).trim() %></option>
                                <% }) %>
                            </select>
                        </label>
                        <label>
                            Home Care Client
                            <select id="edit-patient-id">
                                <option value="">Select patient…</option>
                                <% patients.forEach(p => { %>
                                    <option value="<%= p.id %>"><%= p.name || ((p.first_name||'') + ' ' + (p.last_name||'')).trim() %></option>
                                <% }) %>
                            </select>
                        </label>
                        <label>
                            Date
                            <input type="date" id="edit-date" required>
                        </label>
                        <div class="two-time-grid">
                            <label>
                                Start time
                                <input type="time" id="edit-start" required>
                            </label>
                            <label>
                                End time
                                <input type="time" id="edit-end" required>
                            </label>
                        </div>
                        <label>
                            Service type
                            <select id="edit-service">
                                <% ['Personal Care','Domestic Assistance','Companionship','Medication Assistance','Meal Preparation','Overnight Care','Live-in Care','Palliative Care','Respite Care','Healthcare Staffing'].forEach(st => { %>
                                    <option value="<%= st %>"><%= st %></option>
                                <% }) %>
                            </select>
                        </label>
                        <label>
                            Status
                            <select id="edit-status">
                                <option value="scheduled">Scheduled</option>
                                <option value="clocked_in">Live (Clocked In)</option>
                                <option value="clocked_out">Clocked Out</option>
                                <option value="completed">Completed</option>
                                <option value="cancelled">Cancelled</option>
                                <option value="no_show">No Show</option>
                            </select>
                        </label>
                        <label>
                            Care Instructions <span style="font-weight:400;color:var(--text-muted)">(shown read-only to staff)</span>
                            <textarea id="edit-notes" rows="3" placeholder="Care instructions or notes…"></textarea>
                        </label>
                        <div class="form-actions">
                            <button type="submit" class="primary-button">Save changes</button>
                            <button type="button" class="secondary-button" id="modal-cancel">Cancel</button>
                        </div>
                    </form>
                    <p id="edit-message" class="form-message" aria-live="polite"></p>
                </div>
            </div>

        <% } else { %>
            <!-- ========== STAFF: Clock in / out view ========== -->
            <header class="portal-header">
                <div>
                    <span class="eyebrow">Staff attendance</span>
                    <h1>Live and scheduled shifts</h1>
                </div>
                <div class="header-actions">
                    <strong class="portal-user-name"><%= currentStaffName %></strong>
                </div>
            </header>

            <% if (liveShift) { %>
                <section class="portal-panel">
                    <div class="panel-header">
                        <h2>Live shift</h2>
                        <span class="badge shift-status-clocked_in">Live</span>
                    </div>
                    <p><strong>Patient:</strong> <%= liveShift.patientName %></p>
                    <p><strong>Assigned staff:</strong> <%= liveShift.staffName %></p>
                    <p style="margin-top:8px"><strong>Scheduled:</strong>
                        <%= new Date(liveShift.scheduledStart).toLocaleString() %>
                        – <%= new Date(liveShift.scheduledEnd).toLocaleString() %>
                    </p>
                    <div style="margin-top:16px">
                        <button class="primary-button" type="button" data-shift-id="<%= liveShift.id %>" data-action="clock-out">Clock out</button>
                    </div>
                </section>
            <% } %>

            <section class="portal-panel">
                <div class="panel-header">
                    <h2>Scheduled shifts</h2>
                </div>
                <% if (shifts && shifts.length) { %>
                    <div class="shift-list">
                        <% shifts.forEach((shift) => { %>
                            <article class="shift-card">
                                <div>
                                    <span class="adm-badge <%= shift.serviceDivision === 'agency-staffing' ? 'adm-badge-agency' : 'adm-badge-home-care' %>"><%= shift.serviceDivisionLabel %></span>
                                    <strong><%= shift.displayEntityName || shift.patientName %></strong>
                                    <small><%= shift.shiftCode || ('#' + shift.id) %></small>
                                </div>
                                <div class="shift-times">
                                    <span><%= shift.scheduledStart ? new Date(shift.scheduledStart).toLocaleString() : 'TBC' %></span>
                                    <span class="badge shift-status-<%= shift.statusClass %>">
                                        <%= shift.statusLabel %>
                                    </span>
                                </div>
                                <a class="adm-btn-secondary" href="/admin/shifts/<%= shift.id %>">View details</a>
                                <% if (shift.status === 'scheduled') { %>
                                    <button class="primary-button" type="button" data-shift-id="<%= shift.id %>" data-action="clock-in">Clock in</button>
                                <% } else if (shift.status === 'clocked_in') { %>
                                    <button class="primary-button" type="button" data-shift-id="<%= shift.id %>" data-action="clock-out">Clock out</button>
                                <% } %>
                            </article>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="empty-hint">No shifts are scheduled yet.</p>
                <% } %>
            </section>
        <% } %>

        </main>
    </div>

    <script>
    <% if (isAdmin) { %>
    // ===== Filter tabs =====
    const filterBtns = document.querySelectorAll('.shift-filter-btn');
    const shiftRows  = document.querySelectorAll('.shift-row');
    const noMatchMsg = document.getElementById('no-match-msg');

    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            filterBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const f = btn.dataset.filter;
            let visible = 0;
            shiftRows.forEach(row => {
                const show = f === 'all' || row.dataset.status === f;
                row.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            if (noMatchMsg) noMatchMsg.style.display = (visible === 0 && shiftRows.length > 0) ? 'block' : 'none';
        });
    });

    // ===== Edit modal helpers =====
    const modal    = document.getElementById('edit-modal');
    const editForm = document.getElementById('edit-form');
    const editMsg  = document.getElementById('edit-message');

    function openModal(btn) {
        document.getElementById('edit-shift-id').value   = btn.dataset.id;
        document.getElementById('edit-staff-id').value   = btn.dataset.staffId   || '';
        document.getElementById('edit-patient-id').value = btn.dataset.patientId || '';
        document.getElementById('edit-service').value    = btn.dataset.service   || 'Personal Care';
        document.getElementById('edit-status').value     = btn.dataset.status    || 'scheduled';
        document.getElementById('edit-notes').value      = btn.dataset.notes     || '';

        const start = btn.dataset.start;
        const end   = btn.dataset.end;
        if (start) {
            const d = new Date(start);
            document.getElementById('edit-date').value  = d.toISOString().slice(0,10);
            document.getElementById('edit-start').value = d.toTimeString().slice(0,5);
        }
        if (end) {
            document.getElementById('edit-end').value = new Date(end).toTimeString().slice(0,5);
        }
        editMsg.textContent = '';
        editMsg.className   = 'form-message';
        modal.style.display = 'flex';
    }

    function closeModal() { modal.style.display = 'none'; }

    const modalCloseBtn = document.getElementById('modal-close');
    const modalCancelBtn = document.getElementById('modal-cancel');
    if (modal && modalCloseBtn && modalCancelBtn) {
        modalCloseBtn.addEventListener('click', closeModal);
        modalCancelBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
    }

    // ===== Table action delegation =====
    const tableEl = document.getElementById('shifts-table');
    if (tableEl) {
        tableEl.addEventListener('click', async (e) => {
            const btn = e.target.closest('[data-action]');
            if (!btn) return;
            const action = btn.dataset.action;
            const id     = btn.dataset.id;

            if (action === 'edit') {
                openModal(btn);
            } else if (action === 'delete') {
                if (!confirm('Remove this shift? This cannot be undone.')) return;
                try {
                    const res  = await fetch('/api/shifts/' + id, { method: 'DELETE' });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.message || 'Could not remove shift.');
                    btn.closest('tr').remove();
                } catch (err) {
                    alert(err.message);
                }
            }
        });
    }

    // ===== Save edit =====
    if (editForm) {
    editForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        editMsg.textContent = '';
        editMsg.className   = 'form-message';
        const shiftId = document.getElementById('edit-shift-id').value;
        const payload = {
            staff_id:     document.getElementById('edit-staff-id').value,
            patient_id:   document.getElementById('edit-patient-id').value,
            shift_date:   document.getElementById('edit-date').value,
            start_time:   document.getElementById('edit-start').value,
            end_time:     document.getElementById('edit-end').value,
            service_type: document.getElementById('edit-service').value,
            status:       document.getElementById('edit-status').value,
            notes:        document.getElementById('edit-notes').value,
            care_instructions: document.getElementById('edit-notes').value,
        };
        try {
            const res  = await fetch('/api/shifts/' + shiftId, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.message || 'Could not save changes.');
            editMsg.textContent = 'Shift updated.';
            editMsg.classList.add('success');
            setTimeout(() => { closeModal(); window.location.reload(); }, 500);
        } catch (err) {
            editMsg.textContent = err.message;
            editMsg.classList.add('error');
        }
    });
    }

    <% } else { %>
    // ===== Staff clock in/out =====
    document.querySelectorAll('[data-action]').forEach(button => {
        button.addEventListener('click', () => {
            const shiftId = button.dataset.shiftId;
            const action  = button.dataset.action;
            if (!navigator.geolocation) {
                alert('Geolocation is required to clock in or out of a care shift.');
                return;
            }
            navigator.geolocation.getCurrentPosition(async (position) => {
                const route = action === 'clock-in'
                    ? `/api/staff/shifts/${shiftId}/clock-in`
                    : `/api/staff/shifts/${shiftId}/clock-out`;
                try {
                    const response = await fetch(route, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ latitude: position.coords.latitude, longitude: position.coords.longitude })
                    });
                    const data = await response.json();
                    if (!response.ok) throw new Error(data.message || 'Unable to update shift status.');
                    window.location.href = '/portal/shifts?status=' + encodeURIComponent(data.message);
                } catch (error) {
                    alert(error.message);
                }
            }, () => {
                alert('Location permission is required to clock in and out only when you are at the patient location.');
            }, { enableHighAccuracy: true, timeout: 20000 });
        });
    });
    <% } %>
    </script>
</body>
</html>

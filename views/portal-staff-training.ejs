<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/logo.png">
</head>
<body class="portal-shell-page">
    <div class="portal-layout">
        <%- include('partials/portal-sidebar', { active: 'training', isAdmin: false, currentStaffName: currentStaffName, currentStaffEmail: currentStaffEmail }) %>
        <main class="portal-content">
            <div class="adm-page-header">
                <div>
                    <h1 class="adm-page-title">Training</h1>
                    <p class="adm-page-subtitle">Completed, upcoming, and expired training items</p>
                </div>
            </div>

            <div class="adm-card">
                <% if (training.length) { %>
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <thead><tr><th>Training</th><th>Status</th><th>Completed</th><th>Expiry</th></tr></thead>
                            <tbody>
                                <% training.forEach((item) => { %>
                                    <tr>
                                        <td><strong><%= item.title %></strong></td>
                                        <td><span class="adm-badge adm-badge-<%= item.status === 'expired' ? 'cancelled' : item.status === 'upcoming' ? 'awaiting' : 'completed' %>"><%= item.status %></span></td>
                                        <td><%= item.completed_at ? String(item.completed_at).slice(0, 10) : '—' %></td>
                                        <td><%= item.expires_at ? String(item.expires_at).slice(0, 10) : '—' %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="adm-card-empty"><p>No training records available.</p></div>
                <% } %>
            </div>
        </main>
    </div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/logo.png">
    <%- include('partials/portal-theme-head') %>
</head>
<body class="portal-page">
    <div class="portal-shell">
        <div class="portal-card">
            <div class="portal-branding">
                <img class="brand-logo" src="/images/logo.png" alt="Everkind logo" />
                <div><h1>Everkind</h1><p>Facility portal reset</p></div>
            </div>
            <h2>Forgot your password?</h2>
            <p class="portal-subtext">Approved facility accounts can request a secure reset code using their registered email.</p>
            <% if (error) { %><div class="form-message error"><%= error %></div><% } %>
            <% if (message) { %><div class="form-message success"><%= message %></div><% } %>
            <% if (previewCode) { %><div class="form-message success">Development preview code: <strong><%= previewCode %></strong></div><% } %>
            <form class="portal-form" method="POST" action="/facility-portal/forgot-password">
                <label>Facility email<input type="email" name="email" placeholder="facility@organisation.ie" required></label>
                <button type="submit" class="primary-button full-width">Generate reset code</button>
            </form>
            <div class="portal-links">
                <a href="/facility-portal/reset-password">I already have a code</a>
                <a href="/facility-portal/login">Back to login</a>
            </div>
            <%- include('partials/portal-theme-toggle') %>
        </div>
    </div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/logo.png">
</head>
<body class="portal-shell-page">
    <div class="portal-layout">
        <%- include('partials/portal-sidebar', { active: 'roster', isAdmin: false, currentStaffName: currentStaffName, currentStaffEmail: currentStaffEmail }) %>
        <main class="portal-content">
            <div class="adm-page-header">
                <div>
                    <h1 class="adm-page-title">Weekly Roster</h1>
                    <p class="adm-page-subtitle"><%= weekLabel %></p>
                </div>
                <div style="display:flex;gap:8px;">
                    <form method="GET" action="/portal/weekly-roster" style="display:flex;gap:8px;align-items:center;">
                        <input class="adm-form-input" type="date" name="week" value="<%= weekStart %>">
                        <button class="adm-btn-secondary" type="submit">Filter week</button>
                    </form>
                    <button class="adm-btn-primary" type="button" onclick="window.print()">Export to PDF</button>
                </div>
            </div>

            <div class="adm-card">
                <% if (roster.length) { %>
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <thead><tr><th>Date</th><th>Time</th><th>Client</th><th>Address</th><th>Care Type</th><th>Status</th></tr></thead>
                            <tbody>
                                <% roster.forEach((shift) => { %>
                                    <tr>
                                        <td><%= (shift.scheduledStart || '').slice(0, 10) %></td>
                                        <td><%= (shift.scheduledStart || '').slice(11, 16) %> - <%= (shift.scheduledEnd || '').slice(11, 16) %></td>
                                        <td><%= shift.patientName %></td>
                                        <td><%= shift.address || 'Address unavailable' %></td>
                                        <td><%= shift.serviceType %></td>
                                        <td><span class="adm-badge adm-badge-<%= shift.status === 'completed' ? 'completed' : ['clocked_in', 'break'].includes(shift.status) ? 'clocked-in' : ['cancelled', 'missed', 'attendance_exception'].includes(shift.status) ? 'cancelled' : 'scheduled' %>"><%= shift.statusLabel %></span></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="adm-card-empty"><p>No shifts assigned in this week.</p></div>
                <% } %>
            </div>
        </main>
    </div>
</body>
</html>

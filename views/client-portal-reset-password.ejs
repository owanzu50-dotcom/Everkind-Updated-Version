<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/logo.png">
    <%- include('partials/portal-theme-head') %>
</head>
<body class="portal-page">
    <div class="portal-shell">
        <div class="portal-card">
            <div class="portal-branding">
                <img class="brand-logo" src="/images/logo.png" alt="Everkind logo" />
                <div><h1>Everkind</h1><p>Facility portal reset</p></div>
            </div>
            <h2>Set your password</h2>
            <p class="portal-subtext">Enter the reset code and create a secure password for your approved facility account.</p>
            <% if (error) { %><div class="form-message error"><%= error %></div><% } %>
            <% if (message) { %><div class="form-message success"><%= message %></div><% } %>
            <form class="portal-form" method="POST" action="/facility-portal/reset-password">
                <label>Facility email<input type="email" name="email" placeholder="facility@organisation.ie" required></label>
                <label>Reset code<input type="text" name="code" placeholder="6-digit code" required></label>
                <label>New password<input type="password" name="password" minlength="8" required></label>
                <button type="submit" class="primary-button full-width">Set password</button>
            </form>
            <div class="portal-links">
                <a href="/facility-portal/forgot-password">Request another code</a>
                <a href="/facility-portal/login">Back to login</a>
            </div>
            <%- include('partials/portal-theme-toggle') %>
        </div>
    </div>
</body>
</html>

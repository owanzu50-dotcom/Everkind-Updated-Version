<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Explore live healthcare jobs with Everkind across Ireland, including nursing, care, support, housekeeping, and catering roles.">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/logo.png">
</head>
<body class="public-page careers-premium-page">
    <%- include('partials/site-header', { active: 'careers' }) %>

    <%
        const jobs = Array.isArray(publishedJobs) ? publishedJobs : [];
        const benefits = [
            { key: "heart", title: "Work That Matters", text: "Make a real impact in your community every day." },
            { key: "clock", title: "Flexible Schedules", text: "Choose shifts that fit your lifestyle and commitments." },
            { key: "wallet", title: "Great Pay & Benefits", text: "Competitive rates, weekly pay and bonus incentives." },
            { key: "cap", title: "Career Development", text: "Access training, CPD and clear career pathways." },
            { key: "team", title: "Supportive Team", text: "Work with a team that values kindness and respect." },
            { key: "pin", title: "Nationwide Opportunities", text: "Roles available across Ireland, in homes and healthcare facilities." }
        ];
        const values = [
            { key: "heart", title: "Kindness" },
            { key: "shield", title: "Professionalism" },
            { key: "hands", title: "Respect" },
            { key: "cap", title: "Learning & Development" },
            { key: "team", title: "Teamwork" },
            { key: "spark", title: "Making a Difference" }
        ];
        const indicators = [
            { key: "heart", title: "Meaningful Work" },
            { key: "clock", title: "Flexible Shifts" },
            { key: "wallet", title: "Competitive Pay" },
            { key: "growth", title: "Career Growth" }
        ];
        const roleIconKey = (job) => {
            const title = String(job?.title || "").toLowerCase();
            if (title.includes("nurse")) return "nurse";
            if (title.includes("midwife")) return "midwife";
            if (title.includes("coordinator")) return "coord";
            if (title.includes("senior") || title.includes("lead")) return "shield";
            if (title.includes("pharmac")) return "pharmacy";
            if (title.includes("social")) return "community";
            if (title.includes("allied")) return "allied";
            if (title.includes("multitask")) return "clipboard";
            if (title.includes("assistant")) return "care";
            return "care";
        };
        const iconSvg = (key) => {
            switch (key) {
                case "heart": return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.35-9-8.38C1.55 8.8 3.2 5.5 6.52 5.2c1.87-.18 3.48.8 4.48 2.1 1-1.3 2.61-2.28 4.48-2.1 3.32.3 4.97 3.6 3.52 6.42C19 15.65 12 20 12 20Z"/></svg>';
                case "clock": return '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>';
                case "wallet": return '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="3"/><path d="M16 12h5"/><circle cx="16" cy="12" r="1"/></svg>';
                case "growth": return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19h16"/><path d="M6 15l4-4 3 3 5-6"/><path d="M15 8h3v3"/></svg>';
                case "cap": return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9 12 5l9 4-9 4-9-4Z"/><path d="M7 11v4c0 1.7 2.2 3 5 3s5-1.3 5-3v-4"/></svg>';
                case "team": return '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="9" r="3"/><circle cx="16.5" cy="10" r="2.5"/><path d="M4 19c0-2.8 2.5-5 5.5-5S15 16.2 15 19"/><path d="M14 18.5c.2-2.1 2-3.8 4.2-3.8 1.1 0 2.1.4 2.8 1.1"/></svg>';
                case "pin": return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s6-5.7 6-10a6 6 0 1 0-12 0c0 4.3 6 10 6 10Z"/><circle cx="12" cy="11" r="2.2"/></svg>';
                case "shield": return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3.5 8.2-7 10-3.5-1.8-7-5-7-10V6l7-3Z"/></svg>';
                case "hands": return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 12 5.8 9.8a2 2 0 0 0-2.8 2.8L7.5 17a4 4 0 0 0 2.8 1.2H14"/><path d="M16 12l2.2-2.2a2 2 0 0 1 2.8 2.8L16.5 17a4 4 0 0 1-2.8 1.2H10"/><path d="M10 8v6"/><path d="M14 8v6"/></svg>';
                case "spark": return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 4.2L18 9l-4.2 1.8L12 15l-1.8-4.2L6 9l4.2-1.8L12 3Z"/><path d="M5 16l.8 1.8L7.6 19l-1.8.8L5 21l-.8-1.2L2.4 19l1.8-1.2L5 16Z"/><path d="M19 15l1 2.2L22 18l-2 .8L19 21l-1-2.2L16 18l2-.8 1-2.2Z"/></svg>';
                case "nurse": return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v6"/><path d="M9 6h6"/><circle cx="12" cy="11" r="3"/><path d="M5 20c0-3.3 3.1-6 7-6s7 2.7 7 6"/></svg>';
                case "coord": return '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6.5" cy="7.5" r="2.5"/><circle cx="17.5" cy="7.5" r="2.5"/><circle cx="12" cy="16.5" r="2.5"/><path d="M8.7 9.2 10.8 14"/><path d="M15.3 9.2 13.2 14"/></svg>';
                case "pharmacy": return '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="13" rx="3"/><path d="M12 9v7"/><path d="M8.5 12.5h7"/></svg>';
                case "community": return '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7.5" cy="9" r="2.5"/><circle cx="12" cy="7.5" r="2.5"/><circle cx="16.5" cy="9" r="2.5"/><path d="M3.5 19c0-2.5 1.9-4.5 4.3-4.5"/><path d="M8.5 19c0-2.8 1.8-5 3.5-5s3.5 2.2 3.5 5"/><path d="M16.2 14.5c2.4 0 4.3 2 4.3 4.5"/></svg>';
                case "allied": return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18"/><path d="M6 7h12"/><path d="M6 17h12"/><circle cx="12" cy="12" r="3"/></svg>';
                case "midwife": return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-5.8-3.7-7.5-7.2A5.1 5.1 0 0 1 12 6.5a5.1 5.1 0 0 1 7.5 6.3C17.8 16.3 12 20 12 20Z"/><path d="M12 4v3"/><path d="M10.5 5.5h3"/></svg>';
                case "clipboard": return '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4.5h6v3H9z"/><path d="M9 11h6"/><path d="M9 15h6"/></svg>';
                default: return '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3"/><path d="M5 20c0-3.4 3.1-6.2 7-6.2s7 2.8 7 6.2"/></svg>';
            }
        };
    %>

    <main id="main-content" tabindex="-1">
        <section class="careers-hero">
            <div class="container careers-hero__grid">
                <div class="careers-hero__copy">
                    <span class="careers-kicker">CAREERS AT EVERKIND</span>
                    <h1>Join the Everkind family.</h1>
                    <p>We're looking for kind, passionate and dedicated people who want to make a real difference in the lives of others.</p>
                    <div class="careers-hero__actions">
                        <a href="#live-vacancies" class="primary-button">View Open Roles</a>
                        <a href="#why-work-everkind" class="secondary-button">Why Work With Us</a>
                        <a href="/apply" class="secondary-button careers-join-us-button">Join Us</a>
                    </div>
                    <div class="careers-indicators" aria-label="Career highlights">
                        <% indicators.forEach((item) => { %>
                            <article class="careers-indicator">
                                <span class="careers-icon careers-icon--tiny"><%- iconSvg(item.key) %></span>
                                <span><%= item.title %></span>
                            </article>
                        <% }) %>
                    </div>
                </div>
                <div class="careers-hero__media">
                    <img src="/images/careers-team-hero.png" alt="Everkind healthcare team members together in a professional setting" loading="eager">
                </div>
            </div>
        </section>

        <section id="why-work-everkind" class="container content-section careers-join">
            <div class="careers-section-heading">
                <span class="eyebrow">Why join Everkind?</span>
                <h2>More than a job.<br><span>A purpose.</span></h2>
            </div>
            <div class="careers-benefits-grid">
                <% benefits.forEach((benefit) => { %>
                    <article class="careers-benefit-card">
                        <span class="careers-icon"><%- iconSvg(benefit.key) %></span>
                        <h3><%= benefit.title %></h3>
                        <p><%= benefit.text %></p>
                    </article>
                <% }) %>
            </div>
        </section>

        <section id="live-vacancies" class="container content-section careers-vacancies">
            <div class="careers-section-heading careers-section-heading--split">
                <div>
                    <span class="eyebrow">Live vacancies</span>
                    <h2>Current roles available now.</h2>
                    <p>Explore opportunities that match your skills and experience. New roles are added regularly.</p>
                </div>
                <% if (jobs.length > 3) { %>
                    <a href="#live-vacancies" class="secondary-button">View All Vacancies</a>
                <% } %>
            </div>

            <% if (jobs.length) { %>
                <div class="careers-vacancy-list" aria-live="polite">
                    <% jobs.forEach((job) => { %>
                        <article class="careers-vacancy-card">
                            <span class="careers-icon careers-icon--role"><%- iconSvg(roleIconKey(job)) %></span>
                            <div class="careers-vacancy-card__body">
                                <div class="careers-vacancy-card__head">
                                    <h3><%= job.title || "Healthcare Role" %></h3>
                                    <div class="careers-vacancy-card__badges">
                                        <% if (job.urgent) { %><span class="job-badge job-badge--urgent">Urgent</span><% } %>
                                        <% if (job.featured) { %><span class="job-badge">Featured</span><% } %>
                                        <% if (!job.urgent && !job.featured && job.employment_type) { %><span class="job-badge"><%= job.employment_type %></span><% } %>
                                    </div>
                                </div>
                                <p class="careers-vacancy-card__meta">
                                    <strong><%= job.location || "Dublin" %></strong>
                                    <% if (job.county) { %><span><%= job.county %></span><% } %>
                                    <span><%= job.employment_type || "Flexible" %></span>
                                </p>
                                <p><%= job.description || "A rewarding opportunity to join the Everkind care team." %></p>
                                <ul class="careers-vacancy-card__details">
                                    <li>Salary: <%= job.salary || "Competitive" %></li>
                                    <li>Closing date: <%= job.closing_date || "Open until filled" %></li>
                                </ul>
                            </div>
                            <div class="careers-vacancy-card__actions">
                                <a href="/apply" class="primary-button small">Apply Now</a>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <article class="content-card">
                    <p>No vacancies are currently available. Please check back soon.</p>
                </article>
            <% } %>
        </section>

        <section class="container content-section careers-values">
            <div class="careers-section-heading narrow">
                <span class="eyebrow">Career values</span>
                <h2>Build your career with Everkind.</h2>
            </div>
            <div class="careers-values-grid">
                <% values.forEach((value) => { %>
                    <article class="careers-value-card">
                        <span class="careers-icon"><%- iconSvg(value.key) %></span>
                        <h3><%= value.title %></h3>
                    </article>
                <% }) %>
            </div>
        </section>

        <section class="container content-section">
            <div class="careers-cta">
                <div>
                    <span class="eyebrow">Ready to make a difference?</span>
                    <h2>Join a team that values kindness, respect and professionalism.</h2>
                </div>
                <a href="/apply" class="primary-button">Apply Today</a>
            </div>
        </section>
    </main>

    <%- include('partials/site-footer') %>
</body>
</html>

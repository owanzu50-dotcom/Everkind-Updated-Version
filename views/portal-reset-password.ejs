<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/logo.png">
</head>
<body class="portal-page">
    <div class="portal-shell">
        <div class="portal-card">
            <div class="portal-branding">
                <img class="brand-logo" src="/images/logo.png" alt="Everkind logo" />
                <div>
                    <h1>Everkind</h1>
                    <p>Reset staff password</p>
                </div>
            </div>

            <h2>Reset password</h2>
            <p class="portal-subtext">Enter the reset code and choose a new password.</p>
            <% if (error) { %><div class="form-message error"><%= error %></div><% } %>
            <% if (message) { %><div class="form-message success"><%= message %></div><% } %>

            <form class="portal-form" method="POST" action="/portal/reset-password">
                <label>
                    Staff email
                    <input type="email" name="email" placeholder="you@everkind.com" required>
                </label>
                <label>
                    Reset code
                    <input type="text" name="code" placeholder="6-digit code" required>
                </label>
                <label>
                    New password
                    <input type="password" name="password" minlength="8" required>
                </label>
                <button type="submit" class="primary-button full-width">Reset password</button>
            </form>

            <div class="portal-links">
                <a href="/portal/forgot-password">Request another code</a>
                <a href="/portal/login">Back to sign in</a>
            </div>
        </div>
    </div>
</body>
</html>

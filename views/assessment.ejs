<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/png" href="/images/logo.png">
</head>
<body class="public-page">
    <%- include('partials/site-header', { active: 'assessment' }) %>

    <main class="container content-section">
        <div class="section-heading">
            <span class="eyebrow">Request an assessment</span>
            <h1>Tell us a little about the support you need.</h1>
        </div>
        <div class="info-grid two-col">
            <div class="content-card">
                <h3>What to expect</h3>
                <ul class="check-list">
                    <li>We discuss care needs, routines, and support goals.</li>
                    <li>We review the level of care and likely schedule.</li>
                    <li>We follow up with a tailored plan and next steps.</li>
                </ul>
            </div>
            <form class="content-card assessment-form">
                <label>Full name<input type="text" name="name" placeholder="Your name" required></label>
                <label>Email<input type="email" name="email" placeholder="you@example.com" required></label>
                <label>Phone<input type="tel" name="phone" placeholder="Contact number"></label>
                <label>Support required<textarea rows="5" name="need" placeholder="Describe the type of care support needed"></textarea></label>
                <button type="submit" class="primary-button">Submit assessment request</button>
            </form>
        </div>
    </main>

    <%- include('partials/site-footer') %>
</body>
</html>
